# Leave unset for local development — vite.config.js proxies /api and
# /socket.io to http://localhost:4000 automatically.
#
# When you deploy the frontend and backend separately (e.g. frontend on
# Vercel/Netlify, backend on Render/Railway), set this to your backend's
# public URL so the browser talks to it directly:
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=
